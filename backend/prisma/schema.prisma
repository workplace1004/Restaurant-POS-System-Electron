generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id   String @id @default(cuid())
  name String
  role String // admin, kitchen, waiter
  pin  String
}

model PriceGroup {
  id        String  @id @default(cuid())
  name      String
  tax       String? // e.g. standard, reduced, zero
  sortOrder Int     @default(0)
}

model Category {
  id                    String    @id @default(cuid())
  name                  String
  sortOrder             Int       @default(0)
  inWebshop             Boolean   @default(true)
  displayOnCashRegister Boolean   @default(true)
  nextCourse            String?
  products              Product[]
}

model Product {
  id          String   @id @default(cuid())
  number      Int      @default(0)
  name        String
  price       Float
  categoryId  String
  sortOrder   Int      @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  // General (extra)
  keyName           String?
  productionName    String?
  vatTakeOut        String?
  vatEatIn          String?
  barcode           String?
  printer1          String?
  printer2          String?
  printer3          String?
  addition          String?
  categoryIdsJson   String?  // JSON array of category ids [id1, id2, ...]

  // Advanced
  openPrice           Boolean? @default(false)
  weegschaal          Boolean? @default(false)
  subproductRequires  Boolean? @default(false)
  leeggoedPrijs       String?
  pagerVerplicht      Boolean? @default(false)
  boldPrint           Boolean? @default(false)
  groupingReceipt     Boolean? @default(true)
  labelExtraInfo      String?
  kassaPhotoPath      String?
  voorverpakVervaltype String?
  houdbareDagen       String?
  bewarenGebruik      String?

  // Extra prices (JSON array of { priceGroupId, priceGroupLabel, otherName, otherPrinter, otherPrice })
  extraPricesJson     String?

  // Purchase and stock
  purchaseVat                String?
  purchasePriceExcl          String?
  purchasePriceIncl          String?
  profitPct                  String?
  unit                       String?
  unitContent                String?
  stock                      String?
  supplierCode               String?
  stockNotification          Boolean? @default(true)
  expirationDate             String?
  declarationExpiryDays      String?
  notificationSoldOutPieces  String?

  // Webshop
  inWebshop          Boolean? @default(false)
  onlineOrderable    Boolean? @default(true)
  websiteRemark      String?
  websiteOrder       String?
  shortWebText       String?
  websitePhotoPath   String?

  // Kiosk
  kioskInfo        String?
  kioskTakeAway     Boolean? @default(true)
  kioskEatIn        String?
  kioskSubtitle     String?
  kioskMinSubs      String?
  kioskMaxSubs      String?
  kioskPicturePath  String?
}

model Table {
  id       String   @id @default(cuid())
  name     String
  status   String   @default("available") // available, occupied
  orders   Order[]
}

model Customer {
  id           String   @id @default(cuid())
  companyName  String?
  name         String
  street       String?
  phone        String?
  orders       Order[]
}

model Order {
  id         String      @id @default(cuid())
  tableId    String?
  table      Table?      @relation(fields: [tableId], references: [id])
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id])
  status     String      @default("open") // open, in_planning, paid
  total      Float       @default(0)
  source     String      @default("pos") // pos, weborder
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(1)
  price     Float
  notes     String?
}

model SubproductGroup {
  id         String       @id @default(cuid())
  name       String
  sortOrder  Int          @default(0)
  subproducts Subproduct[]
}

model Subproduct {
  id        String           @id @default(cuid())
  name      String
  groupId   String
  sortOrder Int              @default(0)
  group     SubproductGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
}
